# Copy this file to ".env" and fill in your real values.
# Never commit the real ".env" file to git.

# --- Server ---
PORT=5000

# --- PostgreSQL ---
# If using a hosted provider (Render, Railway, Neon, Supabase), they give you
# a single connection string that looks like this:
DATABASE_URL=postgresql://username:password@host:5432/database_name

# --- Email (using Gmail as an example) ---
# For Gmail, you need an "App Password", not your normal password:
# https://myaccount.google.com/apppasswords
EMAIL_USER=your-church-email@gmail.com
EMAIL_PASS=your-16-character-app-password
EMAIL_TO=your-church-email@gmail.com

# --- Frontend URL (for CORS - which sites are allowed to call this API) ---
# You may list multiple deployed frontend origins separated by commas.
# Localhost and private LAN addresses are also allowed for local development.
FRONTEND_URL=http://localhost:5173

# --- Admin management application ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
JWT_SECRET=replace-with-a-long-random-secret
